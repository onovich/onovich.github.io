---
import { animations, graphics, illustrations, pixel } from '../content/editable-art';
import {
  artCategories,
  artPath,
  copy,
  pagePath,
  photoAlbums,
  type ArtCategoryKey,
  type Language,
} from '../content/portfolio';
import { editable } from '../content/editor';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const text = copy[lang];
const copyKey = `copy.${lang}`;
const counts: Record<ArtCategoryKey, number> = {
  pixel: pixel.length,
  illustration: illustrations.length,
  animation: animations.length,
  graphic: graphics.length,
  photography: photoAlbums.index.length,
  poetry: 4,
};
---
<section class="route-page" aria-labelledby="art-title">
  <header class="route-heading route-heading--art">
    <h1 id="art-title" {...editable(`${copyKey}.art.title`)}>{text.art.title}</h1>
  </header>

  <nav class="art-subnav" aria-label={text.art.title}>
    <a href={pagePath('art', lang)} aria-current="page" {...editable(`${copyKey}.art.all`)}>{text.art.all}</a>
    {artCategories.map(category => (
      <a href={artPath(category.key, lang)} {...editable(`${copyKey}.art.${category.key}`)}>{text.art[category.key]}</a>
    ))}
  </nav>

  <div class="art-category-grid">
    {artCategories.map(category => (
      <a class="art-category" href={artPath(category.key, lang)}>
        {category.key === 'poetry' ? (
          <div class="art-category__preview art-category__preview--text" {...editable(`${copyKey}.art.poetryPreview`)}>{text.art.poetryPreview}</div>
        ) : (
          <div class="art-category__preview">
            <img src={category.preview} alt={category.previewAlt} loading="lazy" decoding="async" />
          </div>
        )}
        <div class="art-category__caption">
          <strong {...editable(`${copyKey}.art.${category.key}`)}>{text.art[category.key]}</strong>
          <span>
            {counts[category.key]} <span {...editable(`${copyKey}.art.${category.key === 'photography' ? 'albums' : 'works'}`)}>{category.key === 'photography' ? text.art.albums : text.art.works}</span>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
