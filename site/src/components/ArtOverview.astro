---
import pixel from '../content/pixel.json';
import illustrations from '../content/illustrations.json';
import animations from '../content/gifs.json';
import graphics from '../content/graphics.json';
import photoAlbums from '../content/photoAlbums.json';
import {
  artCategories,
  artPath,
  copy,
  pagePath,
  type ArtCategoryKey,
  type Language,
} from '../content/portfolio';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const text = copy[lang];
const counts: Record<ArtCategoryKey, number> = {
  pixel: pixel.length,
  illustration: illustrations.length,
  animation: animations.length,
  graphic: graphics.length,
  photography: photoAlbums.index.length,
  poetry: 4,
};
---
<section class="route-page" aria-labelledby="art-title">
  <header class="route-heading route-heading--art">
    <h1 id="art-title">{text.art.title}</h1>
  </header>

  <nav class="art-subnav" aria-label={text.art.title}>
    <a href={pagePath('art', lang)} aria-current="page">{text.art.all}</a>
    {artCategories.map(category => (
      <a href={artPath(category.key, lang)}>{text.art[category.key]}</a>
    ))}
  </nav>

  <div class="art-category-grid">
    {artCategories.map(category => (
      <a class="art-category" href={artPath(category.key, lang)}>
        {category.key === 'poetry' ? (
          <div class="art-category__preview art-category__preview--text">{text.art.poetryPreview}</div>
        ) : (
          <div class="art-category__preview">
            <img src={category.preview} alt={category.previewAlt} loading="lazy" decoding="async" />
          </div>
        )}
        <div class="art-category__caption">
          <strong>{text.art[category.key]}</strong>
          <span>
            {counts[category.key]} {category.key === 'photography' ? text.art.albums : text.art.works}
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
