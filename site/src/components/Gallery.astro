---
/**
 * Gallery component — Cargo-style thumbnails grid.
 * Each item: { id, title, desc?, year?, src, width?, height?, links? }
 * Set wide=true for 16:9 thumbnails (codes / games).
 */
interface GalleryLink {
  label: string;
  url: string;
}

interface GalleryItemData {
  id: string;
  title: string;
  desc?: string;
  year?: string;
  src: string;
  width?: number;
  height?: number;
  links?: GalleryLink[];
}

interface Props {
  items: GalleryItemData[];
  wide?: boolean;
}

const { items, wide = false } = Astro.props;
---

<div class="thumbnails-container">
  <div class="thumbnails pswp-gallery" id="gallery">
    {items.map((item, index) => (
      <figure class={`thumb has_title${wide ? ' thumb--wide' : ''}`}>
        <a
          class="thumb_image_link"
          href={item.src}
          data-pswp-width={item.width ?? (wide ? 1780 : 1000)}
          data-pswp-height={item.height ?? (wide ? 1000 : 1000)}
          data-cropped="true"
          target="_blank"
          rel="noreferrer"
          aria-label={`Open ${item.title}`}
        >
          <img
            class="thumb_image"
            src={item.src}
            alt={item.title}
            loading={index < 6 ? 'eager' : 'lazy'}
          />
        </a>
        <figcaption>
          <div class="title">{item.title}</div>
          {(item.desc || item.year || (item.links && item.links.length > 0)) && (
            <div class="tags">
              {item.desc && <div>{item.desc}</div>}
              {item.year && <div>{item.year}</div>}
              {item.links && item.links.length > 0 && (
                <div>
                  {item.links.map((link, i) => (
                    <>
                      <a href={link.url} target="_blank" rel="noopener noreferrer">
                        {link.label}
                      </a>
                      {i < item.links!.length - 1 && <span> / </span>}
                    </>
                  ))}
                </div>
              )}
            </div>
          )}
        </figcaption>
      </figure>
    ))}
  </div>
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '.pswp-gallery',
    children: '.thumb_image_link',
    pswpModule: () => import('photoswipe'),
  });
  lightbox.init();
</script>
