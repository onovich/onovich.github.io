---
/**
 * Gallery component — Cargo-style thumbnails grid.
 * Each item: { id, title, desc?, year?, src, width?, height?, links? }
 * Set wide=true for 16:9 thumbnails (codes / games).
 */
interface GalleryLink {
  label: string;
  url: string;
}

interface GalleryItemData {
  id: string;
  title: string;
  desc?: string;
  year?: string;
  src: string;
  width?: number;
  height?: number;
  links?: GalleryLink[];
  captionHtml?: string;
  hideCaption?: boolean;
  span?: 'all';
}

interface Props {
  items: GalleryItemData[];
  wide?: boolean;
  dense?: boolean;
  natural?: boolean;
  columns?: 2 | 3;
  showCaptions?: boolean;
  captionMode?: 'structured' | 'title-desc-links' | 'html';
  className?: string;
}

const {
  items,
  wide = false,
  dense = false,
  natural = false,
  columns = 3,
  showCaptions = true,
  captionMode = 'structured',
  className = '',
} = Astro.props;

const galleryClass = [
  'thumbnails',
  'pswp-gallery',
  dense ? 'thumbnails--dense' : '',
  natural ? 'thumbnails--natural' : '',
  columns === 2 ? 'thumbnails--columns-2' : '',
  !showCaptions ? 'thumbnails--no-captions' : '',
  className,
].filter(Boolean).join(' ');

function escapeHtml(value: string | number | undefined) {
  return String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function generatedCaptionHtml(item: GalleryItemData) {
  if (captionMode !== 'title-desc-links') return '';

  const links = (item.links || []).map((link) => (
    `<a href="${escapeHtml(link.url || '#')}" target="_blank" rel="noopener noreferrer">${escapeHtml(link.label || 'Link')}</a>`
  )).join(' / ');

  const lines = [
    item.title ? `<b>${escapeHtml(item.title)}</b>` : '',
    item.desc ? escapeHtml(item.desc) : '',
    item.year ? escapeHtml(item.year) : '',
    links,
  ].filter(Boolean);

  return lines.join('<br>');
}
---

<div class="thumbnails-container">
  <div class={galleryClass} id="gallery">
    {items.map((item, index) => (
      <figure class={`thumb has_title${wide ? ' thumb--wide' : ''}${item.span === 'all' ? ' thumb--span-all' : ''}`}>
        <a
          class="thumb_image_link"
          href={item.src}
          data-pswp-width={item.width ?? (wide ? 1780 : 1000)}
          data-pswp-height={item.height ?? (wide ? 1000 : 1000)}
          data-cropped="true"
          target="_blank"
          rel="noreferrer"
          aria-label={`Open ${item.title}`}
        >
          <img
            class="thumb_image"
            src={item.src}
            alt={item.title}
            loading={index < 2 ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={index === 0 ? 'high' : undefined}
          />
        </a>
        {showCaptions && !item.hideCaption && (item.captionHtml || generatedCaptionHtml(item)) && (
          <figcaption class="caption" set:html={item.captionHtml || generatedCaptionHtml(item)} />
        )}
        {showCaptions && !item.hideCaption && !item.captionHtml && !generatedCaptionHtml(item) && (
          <figcaption>
            <div class="title">{item.title}</div>
            {(item.desc || item.year || (item.links && item.links.length > 0)) && (
              <div class="tags">
                {item.desc && <div>{item.desc}</div>}
                {item.year && <div>{item.year}</div>}
                {item.links && item.links.length > 0 && (
                  <div>
                    {item.links.map((link, i) => (
                      <>
                        <a href={link.url} target="_blank" rel="noopener noreferrer">
                          {link.label}
                        </a>
                        {i < item.links.length - 1 && <span> / </span>}
                      </>
                    ))}
                  </div>
                )}
              </div>
            )}
          </figcaption>
        )}
      </figure>
    ))}
  </div>
</div>
