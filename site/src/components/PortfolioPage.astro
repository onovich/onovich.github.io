---
import ProjectCard from './ProjectCard.astro';
import {
  copy,
  pagePath,
  projects,
  type Language,
  type PageKey,
} from '../content/portfolio';
import { editable } from '../content/editor';

interface Props {
  lang: Language;
  page: Exclude<PageKey, 'art'>;
}

const { lang, page } = Astro.props;
const text = copy[lang];
const descriptions = text.projectDescriptions;
const copyKey = `copy.${lang}`;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY;
---
{page === 'home' && (
  <section class="route-page" aria-labelledby="home-title">
    <header class="home-intro">
      <div class="home-intro__copy">
        <h1 id="home-title" {...editable(`${copyKey}.home.title`)}>{text.home.title}</h1>
        <p class="home-intro__body">
          {text.home.body.map((line, index) => <span {...editable(`${copyKey}.home.body.${index}`)}>{line}</span>)}
        </p>
      </div>
      <img
        class="identity-image identity-image--home"
        src="/images/profile/avatar.jpg"
        alt="Pixel-art frog astronaut avatar"
        width="400"
        height="400"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </header>

    <section class="home-work" aria-labelledby="home-work-title">
      <h2 id="home-work-title" class="personal-heading" {...editable(`${copyKey}.home.lead`)}>{text.home.lead}</h2>
      <div class="project-grid project-grid--home">
        <ProjectCard {...projects.ninja} description={descriptions.ninjaShort} editorNameKey="projects.ninja.name" editorDescriptionKey={`${copyKey}.projectDescriptions.ninjaShort`} />
        <ProjectCard {...projects.golf} description={descriptions.golfShort} editorNameKey="projects.golf.name" editorDescriptionKey={`${copyKey}.projectDescriptions.golfShort`} />
        <ProjectCard {...projects.inscape} description={descriptions.inscape} editorNameKey="projects.inscape.name" editorDescriptionKey={`${copyKey}.projectDescriptions.inscape`} />
        <ProjectCard {...projects.prism} description={descriptions.prism} editorNameKey="projects.prism.name" editorDescriptionKey={`${copyKey}.projectDescriptions.prism`} />
      </div>
      <div class="home-paths">
        <a href={pagePath('work', lang)}><span {...editable(`${copyKey}.home.moreWork`)}>{text.home.moreWork}</span> →</a>
        <a href={pagePath('art', lang)}><span {...editable(`${copyKey}.home.moreArt`)}>{text.home.moreArt}</span> →</a>
      </div>
    </section>
  </section>
)}

{page === 'work' && (
  <section class="route-page" aria-labelledby="work-title">
    <header class="route-heading">
      <h1 id="work-title" {...editable(`${copyKey}.work.title`)}>{text.work.title}</h1>
    </header>

    <section class="work-group" aria-labelledby="games-title">
      <div class="group-heading">
        <h2 id="games-title" {...editable(`${copyKey}.work.games`)}>{text.work.games}</h2>
        <p {...editable(`${copyKey}.work.gamesNote`)}>{text.work.gamesNote}</p>
      </div>
      <div class="project-grid">
        <ProjectCard {...projects.ninja} description={descriptions.ninjaLong} editorNameKey="projects.ninja.name" editorDescriptionKey={`${copyKey}.projectDescriptions.ninjaLong`} />
        <ProjectCard {...projects.golf} description={descriptions.golfLong} editorNameKey="projects.golf.name" editorDescriptionKey={`${copyKey}.projectDescriptions.golfLong`} />
      </div>
    </section>

    <section class="work-group" aria-labelledby="systems-title">
      <div class="group-heading">
        <h2 id="systems-title" {...editable(`${copyKey}.work.systems`)}>{text.work.systems}</h2>
        <p {...editable(`${copyKey}.work.systemsNote`)}>{text.work.systemsNote}</p>
      </div>
      <div class="project-grid">
        <ProjectCard {...projects.inscape} description={descriptions.inscape} editorNameKey="projects.inscape.name" editorDescriptionKey={`${copyKey}.projectDescriptions.inscape`} />
        <ProjectCard {...projects.prism} description={descriptions.prism} editorNameKey="projects.prism.name" editorDescriptionKey={`${copyKey}.projectDescriptions.prism`} />
        <ProjectCard {...projects.pulse} description={descriptions.pulse} editorNameKey="projects.pulse.name" editorDescriptionKey={`${copyKey}.projectDescriptions.pulse`} />
        <ProjectCard {...projects.ease} description={descriptions.ease} editorNameKey="projects.ease.name" editorDescriptionKey={`${copyKey}.projectDescriptions.ease`} />
        <ProjectCard {...projects.litio} description={descriptions.litio} editorNameKey="projects.litio.name" editorDescriptionKey={`${copyKey}.projectDescriptions.litio`} />
        <ProjectCard {...projects.beat} description={descriptions.beat} editorNameKey="projects.beat.name" editorDescriptionKey={`${copyKey}.projectDescriptions.beat`} />
      </div>
    </section>

    <section class="work-group" aria-labelledby="publishing-title">
      <div class="group-heading">
        <h2 id="publishing-title" {...editable(`${copyKey}.work.publishing`)}>{text.work.publishing}</h2>
        <p {...editable(`${copyKey}.work.publishingNote`)}>{text.work.publishingNote}</p>
      </div>
      <div class="project-grid">
        <ProjectCard {...projects.repoCover} description={descriptions.repoCover} editorNameKey="projects.repoCover.name" editorDescriptionKey={`${copyKey}.projectDescriptions.repoCover`} />
        <ProjectCard {...projects.repoReadme} description={descriptions.repoReadme} editorNameKey="projects.repoReadme.name" editorDescriptionKey={`${copyKey}.projectDescriptions.repoReadme`} />
      </div>
    </section>
  </section>
)}

{page === 'writing' && (
  <section class="route-page" aria-labelledby="writing-title">
    <header class="route-heading">
      <h1 id="writing-title" {...editable(`${copyKey}.writing.title`)}>{text.writing.title}</h1>
    </header>
    <article class="writing-feature">
      <div>
        <p class="ui-kicker" {...editable(`${copyKey}.writing.publication`)}>{text.writing.publication}</p>
        <h2 {...editable(`${copyKey}.writing.heading`)}>{text.writing.heading}</h2>
        <p {...editable(`${copyKey}.writing.status`)}>{text.writing.status}</p>
      </div>
    </article>
  </section>
)}

{page === 'profile' && (
  <section class="route-page" aria-labelledby="profile-title">
    <header class="route-heading">
      <h1 id="profile-title" {...editable(`${copyKey}.profile.title`)}>{text.profile.title}</h1>
    </header>

    <div class="profile-intro">
      <img
        class="identity-image identity-image--profile"
        src="/images/profile/avatar.jpg"
        alt="Pixel-art frog astronaut avatar"
        width="400"
        height="400"
      />
      <p class="profile-intro__bio">
        {text.profile.bio.map((line, index) => <span {...editable(`${copyKey}.profile.bio.${index}`)}>{line}</span>)}
      </p>
    </div>

    <section class="profile-section" aria-labelledby="profile-focus">
      <h2 id="profile-focus" {...editable(`${copyKey}.profile.focus`)}>{text.profile.focus}</h2>
      <div class="profile-list">
        {text.profile.focusItems.map((item, index) => <p {...editable(`${copyKey}.profile.focusItems.${index}`)}>{item}</p>)}
      </div>
    </section>

    <section class="profile-section" aria-labelledby="profile-experience">
      <h2 id="profile-experience" {...editable(`${copyKey}.profile.experience`)}>{text.profile.experience}</h2>
      <div class="experience-list">
        {text.profile.experiences.map(([title, description], index) => (
          <article><h3 {...editable(`${copyKey}.profile.experiences.${index}.0`)}>{title}</h3><p {...editable(`${copyKey}.profile.experiences.${index}.1`)}>{description}</p></article>
        ))}
      </div>
    </section>
  </section>
)}

{page === 'contact' && (
  <section class="route-page" aria-labelledby="contact-title">
    <header class="route-heading">
      <h1 id="contact-title" {...editable(`${copyKey}.contact.title`)}>{text.contact.title}</h1>
    </header>

    <div class="contact-layout">
      <div class="contact-copy">
        <h2>
          <span {...editable(`${copyKey}.contact.line1`)}>{text.contact.line1}</span>
          <span {...editable(`${copyKey}.contact.line2`)}>{text.contact.line2}</span>
        </h2>
        <ul>
          {text.contact.items.map((item, index) => <li {...editable(`${copyKey}.contact.items.${index}`)}>{item}</li>)}
        </ul>
        <div class="contact-links">
          <a href="mailto:onovich1110@gmail.com" {...editable(`${copyKey}.contact.email`)}>{text.contact.email}</a>
          <a href="https://github.com/onovich" target="_blank" rel="noopener noreferrer"><span {...editable(`${copyKey}.contact.github`)}>{text.contact.github}</span> ↗</a>
          <a href="https://twitter.com/Umbra_Onovich" target="_blank" rel="noopener noreferrer"><span {...editable(`${copyKey}.contact.twitter`)}>{text.contact.twitter}</span> ↗</a>
        </div>
      </div>

      <form
        class="contact-form"
        action="/api/contact"
        method="post"
        data-contact-form
        data-contact-sending={text.contact.formSending}
        data-contact-success={text.contact.formSuccess}
        data-contact-error={text.contact.formError}
      >
        <div class="contact-form__field">
          <label for="contact-name" {...editable(`${copyKey}.contact.formName`)}>{text.contact.formName}</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="contact-form__field">
          <label for="contact-email" {...editable(`${copyKey}.contact.formEmail`)}>{text.contact.formEmail}</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="contact-form__field">
          <label for="contact-subject" {...editable(`${copyKey}.contact.formSubject`)}>{text.contact.formSubject}</label>
          <input id="contact-subject" name="subject" type="text" maxlength="160" autocomplete="off" required />
        </div>
        <div class="contact-form__field">
          <label for="contact-message" {...editable(`${copyKey}.contact.formMessage`)}>{text.contact.formMessage}</label>
          <textarea id="contact-message" name="message" rows="7" required></textarea>
        </div>
        <div class="contact-form__trap" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        {turnstileSiteKey && (
          <div
            class="contact-form__verification"
            data-contact-verification
            data-sitekey={turnstileSiteKey}
            hidden
            aria-hidden="true"
          >
            <div data-contact-turnstile></div>
          </div>
        )}
        <button type="submit"><span {...editable(`${copyKey}.contact.formSubmit`)}>{text.contact.formSubmit}</span></button>
        <p class="contact-form__note" id="contact-form-note" data-contact-status role="status" aria-live="polite" aria-atomic="true">
          <span {...editable(`${copyKey}.contact.formNote`)}>{text.contact.formNote}</span>
        </p>
      </form>
    </div>
  </section>
)}

{turnstileSiteKey && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
)}

<script>
  document.querySelectorAll('form[data-contact-form]').forEach(form => {
    const verification = form.querySelector('[data-contact-verification]');
    const turnstileContainer = verification?.querySelector('[data-contact-turnstile]');
    const turnstileSiteKey = verification?.getAttribute('data-sitekey') ?? '';
    let turnstileReady;
    let turnstileWidgetId;
    let resolveTurnstileToken;
    let rejectTurnstileToken;

    const hideVerification = (reset = true) => {
      if (!(verification instanceof HTMLElement)) return;

      const turnstile = window.turnstile;
      if (reset && turnstileWidgetId !== undefined && turnstile && typeof turnstile.reset === 'function') {
        turnstile.reset(turnstileWidgetId);
      }

      resolveTurnstileToken = undefined;
      rejectTurnstileToken = undefined;
      verification.hidden = true;
      verification.setAttribute('aria-hidden', 'true');
    };

    const showVerification = () => {
      if (!(verification instanceof HTMLElement)) return;

      verification.hidden = false;
      verification.setAttribute('aria-hidden', 'false');
    };

    const waitForTurnstile = () => {
      if (window.turnstile) return Promise.resolve(window.turnstile);
      if (turnstileReady) return turnstileReady;

      turnstileReady = new Promise((resolve, reject) => {
        const timeoutAt = Date.now() + 10_000;
        const check = () => {
          if (window.turnstile) {
            resolve(window.turnstile);
            return;
          }

          if (Date.now() >= timeoutAt) {
            reject(new Error('Turnstile did not load'));
            return;
          }

          window.setTimeout(check, 50);
        };

        check();
      });

      return turnstileReady;
    };

    const requestTurnstileToken = async () => {
      if (!(verification instanceof HTMLElement) || !(turnstileContainer instanceof HTMLElement) || !turnstileSiteKey) {
        return '';
      }

      showVerification();
      const turnstile = await waitForTurnstile();
      if (!turnstile || typeof turnstile.render !== 'function') {
        throw new Error('Turnstile is unavailable');
      }

      return new Promise((resolve, reject) => {
        resolveTurnstileToken = resolve;
        rejectTurnstileToken = reject;

        try {
          if (turnstileWidgetId === undefined) {
            turnstileWidgetId = turnstile.render(turnstileContainer, {
              sitekey: turnstileSiteKey,
              action: 'contact',
              callback: token => {
                if (resolveTurnstileToken) resolveTurnstileToken(token);
              },
              'expired-callback': () => {
                if (rejectTurnstileToken) rejectTurnstileToken(new Error('Turnstile token expired'));
              },
              'error-callback': () => {
                if (rejectTurnstileToken) rejectTurnstileToken(new Error('Turnstile verification failed'));
              },
            });
          } else if (typeof turnstile.reset === 'function') {
            turnstile.reset(turnstileWidgetId);
          }
        } catch (error) {
          resolveTurnstileToken = undefined;
          rejectTurnstileToken = undefined;
          reject(error);
        }
      });
    };

    form.addEventListener('submit', async event => {
      event.preventDefault();

      const submitButton = form.querySelector('button[type="submit"]');
      const status = form.querySelector('[data-contact-status]') ?? form.querySelector('.contact-form__note');
      if (!(submitButton instanceof HTMLButtonElement) || !(status instanceof HTMLElement)) return;

      const formData = new FormData(form);
      const payload = {
        name: String(formData.get('name') ?? '').trim(),
        email: String(formData.get('email') ?? '').trim(),
        subject: String(formData.get('subject') ?? '').trim(),
        message: String(formData.get('message') ?? '').trim(),
        website: String(formData.get('website') ?? '').trim(),
        turnstileToken: '',
      };

      const sending = form.getAttribute('data-contact-sending') ?? 'Sending…';
      const success = form.getAttribute('data-contact-success') ?? 'Message sent.';
      const error = form.getAttribute('data-contact-error') ?? 'The message could not be sent.';

      submitButton.disabled = true;
      status.textContent = sending;
      status.dataset.state = 'pending';

      try {
        payload.turnstileToken = await requestTurnstileToken();
        hideVerification(false);
        const response = await fetch(form.getAttribute('action') ?? '/api/contact', {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => null);

        if (!response.ok || !result?.ok) throw new Error('Contact form request failed');

        form.reset();
        status.textContent = success;
        status.dataset.state = 'success';
      } catch {
        status.textContent = error;
        status.dataset.state = 'error';
      } finally {
        hideVerification();
        submitButton.disabled = false;
      }

    });
  });
</script>
