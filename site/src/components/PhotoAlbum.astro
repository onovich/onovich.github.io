---
import ArtLightbox from './ArtLightbox.astro';
import {
  artPath,
  copy,
  getPhotoAlbumBySlug,
  type Language,
} from '../content/portfolio';
import { editable } from '../content/editor';

interface Props {
  lang: Language;
  slug: string;
}

const { lang, slug } = Astro.props;
const text = copy[lang];
const copyKey = `copy.${lang}`;
const photoAlbum = getPhotoAlbumBySlug(slug);

if (!photoAlbum) {
  throw new Error(`Unknown photography album: ${slug}`);
}

const { album } = photoAlbum;
---
<section class="route-page" aria-labelledby="album-title">
  <header class="route-heading route-heading--art">
    <h1 id="album-title" {...editable(`photoAlbums.${album.slug}.title`)}>{album.title}</h1>
  </header>

  <nav class="art-subnav" aria-label={text.art.photography}>
    <a href={artPath('photography', lang)}>← <span {...editable(`${copyKey}.art.backToPhotography`)}>{text.art.backToPhotography}</span></a>
  </nav>

  <div class="art-section-heading">
    <h2 {...editable(`photoAlbums.${album.slug}.title`)}>{album.title}</h2>
    <p {...editable(`photoAlbums.${album.slug}.year`)}>{album.year}</p>
  </div>

  <div class="art-gallery art-gallery--photography">
    {album.items.map(item => (
      <figure class="art-item">
        <button
          type="button"
          data-lightbox-src={item.src}
          data-lightbox-caption={album.title}
          aria-label={`${text.art.open}: ${album.title}`}
        >
          <img
            src={item.src}
            alt={album.title}
            width={item.width}
            height={item.height}
            loading="lazy"
            decoding="async"
          />
        </button>
      </figure>
    ))}
  </div>
</section>

<ArtLightbox closeLabel={text.close} />
