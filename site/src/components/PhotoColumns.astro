---
interface PhotoItem {
  id: string;
  title?: string;
  year?: string;
  href?: string;
  src: string;
  width?: number;
  height?: number;
}

interface Props {
  items: PhotoItem[];
  showCaptions?: boolean;
  lightbox?: boolean;
}

const { items, showCaptions = false, lightbox = false } = Astro.props;
---

<div class={`photo-columns${showCaptions ? ' photo-columns--captions' : ''}${lightbox ? ' photo-columns--lightbox pswp-gallery' : ''}`}>
  {items.map((item, index) => {
    const media = (
      <img
        src={item.src}
        alt={[item.title, item.year].filter(Boolean).join('')}
        width={item.width}
        height={item.height}
        loading={index < 9 ? 'eager' : 'lazy'}
      />
    );

    return (
      <figure class="photo-card">
        {lightbox ? (
          <a
            class="photo-card__image photo-card__image--lightbox"
            href={item.src}
            data-pswp-width={item.width ?? 1200}
            data-pswp-height={item.height ?? 900}
            target="_blank"
            rel="noreferrer"
            aria-label={`Open ${[item.title, item.year].filter(Boolean).join(' ') || 'photo'}`}
          >
            {media}
          </a>
        ) : item.href ? (
          <a class="photo-card__image" href={item.href}>
            {media}
          </a>
        ) : (
          <div class="photo-card__image">{media}</div>
        )}
        {showCaptions && (
          <figcaption>
            {item.title && <div>{item.title}</div>}
            {item.year && <div>{item.year}</div>}
          </figcaption>
        )}
      </figure>
    );
  })}
</div>
