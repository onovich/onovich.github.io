---
interface Props {
  name: string;
  href: string;
  image: string;
  alt: string;
  description: string;
}

const { name, href, image, alt, description } = Astro.props;
---
<article class="project">
  <a class="project-media" href={href} target="_blank" rel="noopener noreferrer">
    <img src={image} alt={alt} loading="lazy" decoding="async" />
  </a>
  <div class="project-caption">
    <h3><a href={href} target="_blank" rel="noopener noreferrer">{name} ↗</a></h3>
    <p>{description}</p>
  </div>
</article>
