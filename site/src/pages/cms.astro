---
import codes from '../content/codes.json';
import games from '../content/games.json';
import pixel from '../content/pixel.json';
import illustrations from '../content/illustrations.json';
import gifs from '../content/gifs.json';
import graphics from '../content/graphics.json';
import photoAlbums from '../content/photoAlbums.json';
import poemHtml from '../content/poem.html?raw';
import { createCmsSeed } from '../cms/currentContent';
import { validateCmsSite } from '../cms/validation';
import '../styles/cms.css';

const cmsSeed = createCmsSeed({
  codes,
  games,
  pixel,
  illustrations,
  gifs,
  graphics,
  photoAlbums,
  poemHtml,
});
const seedIssues = validateCmsSite(cmsSeed);
const seedJson = JSON.stringify(cmsSeed).replace(/</g, '\\u003c');
const validationJson = JSON.stringify(seedIssues).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Onovich CMS</title>
  </head>
  <body class="cms-page">
    <script type="application/json" id="cms-seed" set:html={seedJson}></script>
    <script type="application/json" id="cms-validation-seed" set:html={validationJson}></script>

    <div class="cms-shell">
      <aside class="cms-rail">
        <div class="cms-brand">
          <strong>Onovich</strong>
          <span>CMS</span>
        </div>
        <div class="cms-rail__actions">
          <button class="cms-button cms-button--primary" id="saveDraftBtn" type="button">保存草稿</button>
          <button class="cms-button" id="publishBtn" type="button">发布预览</button>
          <button class="cms-button" id="exportBtn" type="button">导出发布包</button>
          <label class="cms-button cms-button--file" for="importFile">导入 JSON</label>
          <input id="importFile" type="file" accept="application/json" />
          <button class="cms-button cms-button--danger" id="resetBtn" type="button">重置</button>
        </div>
        <div class="cms-status" id="cmsStatus">Ready</div>
      </aside>

      <nav class="cms-tree">
        <div class="cms-tree__bar">
          <button class="cms-icon-button" id="addCategoryBtn" type="button">类目+</button>
          <button class="cms-icon-button" id="addPageBtn" type="button">页面+</button>
        </div>
        <div class="cms-section-title">类目</div>
        <div id="categoryList" class="cms-list"></div>
        <div class="cms-section-title">页面</div>
        <div id="pageList" class="cms-list cms-list--pages"></div>
      </nav>

      <main class="cms-editor">
        <header class="cms-topbar">
          <div>
            <div class="cms-kicker" id="currentPath">/</div>
            <h1 id="currentTitle">Homepage</h1>
          </div>
          <div class="cms-topbar__tools">
            <button class="cms-button" id="movePageUpBtn" type="button">上移页面</button>
            <button class="cms-button" id="movePageDownBtn" type="button">下移页面</button>
            <button class="cms-button" id="duplicatePageBtn" type="button">复制页面</button>
            <button class="cms-button cms-button--danger" id="deletePageBtn" type="button">删除页面</button>
          </div>
        </header>

        <section class="cms-workbench">
          <div class="cms-pane cms-pane--settings">
            <div class="cms-pane__head">页面模板</div>
            <div class="cms-fields">
              <label>标题<input id="pageTitleInput" type="text" /></label>
              <label>路径<input id="pagePathInput" type="text" /></label>
              <label>类目<input id="pageCategoryInput" type="text" list="categoryOptions" /></label>
              <datalist id="categoryOptions"></datalist>
              <label>模板
                <select id="pageTemplateInput"></select>
              </label>
              <label>左边栏分组
                <select id="pageNavGroupInput">
                  <option value="main">作品区</option>
                  <option value="social">链接区</option>
                  <option value="hidden">不显示</option>
                </select>
              </label>
              <label class="cms-check"><input id="pageSidebarInput" type="checkbox" /> 显示在左边栏</label>
            </div>

            <div class="cms-pane__head cms-pane__head--spaced">页面框架</div>
            <div class="cms-fields">
              <label class="cms-check"><input id="frameBackInput" type="checkbox" /> 显示 &lt; HOME</label>
              <div class="cms-field-grid">
                <label>返回文字<input id="frameBackLabelInput" type="text" /></label>
                <label>返回路径<input id="frameBackHrefInput" type="text" /></label>
              </div>
              <label>页面间距
                <select id="frameTopSpacingInput">
                  <option value="home">首页</option>
                  <option value="inner">普通内页</option>
                  <option value="tight">紧凑作品页</option>
                  <option value="photo">照片页</option>
                  <option value="contact">留言抽屉</option>
                </select>
              </label>
              <label class="cms-check"><input id="frameContactDrawerInput" type="checkbox" /> 启用留言抽屉布局</label>
            </div>

            <div class="cms-pane__head cms-pane__head--spaced">模板说明</div>
            <p class="cms-help" id="templateHelp"></p>
          </div>

          <div class="cms-pane cms-pane--content">
            <div class="cms-tabs">
              <button class="cms-tab is-active" data-tab="sections" type="button">结构</button>
              <button class="cms-tab" data-tab="items" type="button">条目</button>
              <button class="cms-tab" data-tab="text" type="button">正文</button>
              <button class="cms-tab" data-tab="raw" type="button">JSON</button>
            </div>

            <div class="cms-tab-panel is-active" data-panel="sections">
              <div class="cms-panel-toolbar">
                <button class="cms-button" id="addSectionBtn" type="button">新增分段</button>
                <button class="cms-button" id="moveSectionUpBtn" type="button">上移分段</button>
                <button class="cms-button" id="moveSectionDownBtn" type="button">下移分段</button>
                <button class="cms-button cms-button--danger" id="deleteSectionBtn" type="button">删除分段</button>
              </div>
              <div id="sectionList" class="cms-section-list"></div>

              <div class="cms-editor-box">
                <div class="cms-pane__head">分段参数</div>
                <div class="cms-fields">
                  <label>分段 ID<input id="sectionIdInput" type="text" /></label>
                  <label>分段标题<input id="sectionTitleInput" type="text" /></label>
                  <label>预设
                    <select id="sectionPresetInput"></select>
                  </label>
                  <div class="cms-field-grid">
                    <label>列数
                      <select id="sectionColumnsInput">
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                      </select>
                    </label>
                    <label>间距
                      <select id="sectionSpacingInput">
                        <option value="roomy">roomy</option>
                        <option value="dense">dense</option>
                        <option value="flush">flush</option>
                      </select>
                    </label>
                  </div>
                  <div class="cms-field-grid">
                    <label>图片方式
                      <select id="sectionImageFitInput">
                        <option value="natural">natural</option>
                        <option value="cover-square">cover-square</option>
                        <option value="cover-16-9">cover-16-9</option>
                        <option value="contain">contain</option>
                      </select>
                    </label>
                    <label>字幕
                      <select id="sectionCaptionModeInput">
                        <option value="none">none</option>
                        <option value="title-year">title-year</option>
                        <option value="title-desc-links">title-desc-links</option>
                        <option value="html">html</option>
                      </select>
                    </label>
                  </div>
                  <div class="cms-field-grid">
                    <label>点击行为
                      <select id="sectionClickModeInput">
                        <option value="none">none</option>
                        <option value="lightbox">lightbox</option>
                        <option value="internal-page">internal-page</option>
                        <option value="external-link">external-link</option>
                      </select>
                    </label>
                    <label>分段间隔
                      <select id="sectionGapInput">
                        <option value="none">none</option>
                        <option value="normal">normal</option>
                        <option value="large">large</option>
                      </select>
                    </label>
                  </div>
                  <div class="cms-field-grid">
                    <label class="cms-check"><input id="sectionCaptionsInput" type="checkbox" /> 显示字幕</label>
                    <label>自定义宽度<input id="sectionWidthInput" type="number" min="30" max="100" /></label>
                  </div>
                  <div class="cms-row-actions">
                    <button class="cms-button cms-button--primary" id="saveSectionBtn" type="button">保存分段参数</button>
                  </div>
                </div>
              </div>
            </div>

            <div class="cms-tab-panel" data-panel="items">
              <div class="cms-panel-toolbar">
                <button class="cms-button" id="addItemBtn" type="button">新增条目</button>
                <button class="cms-button" id="moveItemUpBtn" type="button">上移条目</button>
                <button class="cms-button" id="moveItemDownBtn" type="button">下移条目</button>
                <button class="cms-button cms-button--danger" id="deleteItemBtn" type="button">删除条目</button>
              </div>
              <div id="itemList" class="cms-item-list"></div>

              <div class="cms-editor-box">
                <div class="cms-pane__head">条目内容</div>
                <div class="cms-fields">
                  <label>ID<input id="itemIdInput" type="text" /></label>
                  <label>标题<input id="itemTitleInput" type="text" /></label>
                  <label>说明<input id="itemDescInput" type="text" /></label>
                  <label>年份<input id="itemYearInput" type="text" /></label>
                  <label>图片路径<input id="itemSrcInput" type="text" /></label>
                  <label class="cms-button cms-button--file cms-button--upload" for="itemUploadInput">选择上传图片</label>
                  <input id="itemUploadInput" type="file" accept="image/png,image/jpeg,image/webp,image/gif" />
                  <label>条目链接<input id="itemHrefInput" type="text" /></label>
                  <label>目标页面 ID<input id="itemTargetPageInput" type="text" /></label>
                  <div class="cms-field-grid">
                    <label>宽<input id="itemWidthInput" type="number" min="0" /></label>
                    <label>高<input id="itemHeightInput" type="number" min="0" /></label>
                  </div>
                  <label>字幕 HTML<textarea id="itemCaptionHtmlInput" spellcheck="false"></textarea></label>
                  <label>正文 HTML<textarea id="itemBodyHtmlInput" spellcheck="false"></textarea></label>
                  <label>文字链接 JSON<textarea id="itemLinksInput" spellcheck="false"></textarea></label>
                  <div class="cms-row-actions">
                    <button class="cms-button cms-button--primary" id="saveItemBtn" type="button">保存条目</button>
                  </div>
                </div>
              </div>
            </div>

            <div class="cms-tab-panel" data-panel="text">
              <div class="cms-rich-toolbar">
                <button data-command="bold" type="button"><b>B</b></button>
                <button data-command="italic" type="button"><i>I</i></button>
                <button data-command="insertUnorderedList" type="button">列表</button>
                <button id="makeLinkBtn" type="button">链接</button>
                <button id="clearFormatBtn" type="button">清除</button>
              </div>
              <div id="richLinkPanel" class="cms-rich-link-panel" hidden>
                <label>链接 URL<input id="richLinkInput" type="url" inputmode="url" placeholder="https://" /></label>
                <div class="cms-rich-link-actions">
                  <button class="cms-button cms-button--primary" id="applyRichLinkBtn" type="button">应用链接</button>
                  <button class="cms-button" id="cancelRichLinkBtn" type="button">取消</button>
                </div>
              </div>
              <div id="richEditor" class="cms-rich-editor" contenteditable="true" spellcheck="false"></div>
              <button class="cms-button cms-button--primary" id="saveBodyBtn" type="button">保存正文</button>
            </div>

            <div class="cms-tab-panel" data-panel="raw">
              <textarea id="rawJson" class="cms-raw" spellcheck="false"></textarea>
              <div class="cms-row-actions">
                <button class="cms-button cms-button--primary" id="applyRawBtn" type="button">应用 JSON</button>
                <button class="cms-button" id="copyRawBtn" type="button">复制 JSON</button>
              </div>
            </div>
          </div>

          <aside class="cms-pane cms-pane--preview">
            <div class="cms-pane__head">实时预览</div>
            <div id="validationList" class="cms-validation"></div>
            <div id="previewFrame" class="cms-preview"></div>
          </aside>
        </section>
      </main>
    </div>

    <div class="cms-review" id="publishReviewPanel" hidden>
      <div class="cms-review__surface" role="dialog" aria-modal="true" aria-labelledby="publishReviewTitle">
        <header class="cms-review__head">
          <div>
            <div class="cms-kicker">Publish review</div>
            <h2 id="publishReviewTitle">发布包检查</h2>
          </div>
          <div class="cms-review__badge" id="publishReviewSummary"></div>
        </header>

        <div class="cms-review__metrics" id="publishReviewMetrics"></div>

        <section class="cms-review__section">
          <div class="cms-pane__head">问题</div>
          <div class="cms-review__issues" id="publishReviewIssues"></div>
        </section>

        <section class="cms-review__section">
          <div class="cms-pane__head">发布目标</div>
          <div class="cms-review__targets" id="publishReviewTargets"></div>
        </section>

        <label class="cms-check cms-review__ack" id="publishReviewAcknowledgeWrap" hidden>
          <input id="publishReviewAcknowledge" type="checkbox" />
          我已确认这些警告
        </label>

        <footer class="cms-review__actions">
          <button class="cms-button" id="publishReviewCancelBtn" type="button">取消</button>
          <button class="cms-button cms-button--primary" id="publishReviewDownloadBtn" type="button">下载发布包</button>
        </footer>
      </div>
    </div>


    <script>
      import '../cms/client';
    </script>
  </body>
</html>
