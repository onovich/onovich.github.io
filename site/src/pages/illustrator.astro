---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import items from '../content/illustrations.json';

const sections = [1, 2, 3]
  .map(section => items.filter(item => item.section === section))
  .filter(sectionItems => sectionItems.length > 0);
---
<BaseLayout title="ILLUSTRATIONS — Onovich" activePage="/illustrator" pageClass="page-illustrator page-gallery-tight">
  {sections.length > 0
    ? sections.map((sectionItems, index) => (
        <>
          {index > 0 && <div class="gallery-section-gap" />}
          <Gallery items={sectionItems} dense={true} natural={true} />
        </>
      ))
    : <p style="color: rgba(0,0,0,0.4); font-size: 1.1rem;">暂无内容</p>}
</BaseLayout>
