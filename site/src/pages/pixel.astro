---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import items from '../content/pixel.json';

const sections = [1, 2]
  .map(section => items.filter(item => item.section === section))
  .filter(sectionItems => sectionItems.length > 0);
---
<BaseLayout title="PIXEL ARTS — Onovich" activePage="/pixel">
  {sections.map((sectionItems, index) => (
    <>
      {index > 0 && <div class="gallery-section-gap" />}
      <Gallery
        items={sectionItems}
        dense={index === 1}
        natural={index === 1}
        className={index === 1 ? 'thumbnails--flush' : ''}
      />
    </>
  ))}
</BaseLayout>
