---
import BaseLayout from '../layouts/BaseLayout.astro';
import { editable, editorText } from '../content/editor';

const title = editorText('system.404.title', 'Page not found — Onovich');
const description = editorText('system.404.description', 'The page you were looking for could not be found.');
const heading = editorText('system.404.heading', 'This page wandered off.');
const returnHome = editorText('system.404.returnHome', 'Return home');
---
<BaseLayout
  lang="en"
  activePage={null}
  title={title}
  description={description}
  canonicalPath="/404/"
  alternatePath="/404/"
  noindex={true}
>
  <section class="route-page not-found" aria-labelledby="not-found-title">
    <header class="route-heading">
      <h1 id="not-found-title" {...editable('system.404.heading')}>{heading}</h1>
    </header>
    <p><a href="/"><span {...editable('system.404.returnHome')}>{returnHome}</span> →</a></p>
  </section>
</BaseLayout>
