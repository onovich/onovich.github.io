---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import items from '../content/gifs.json';
---
<BaseLayout title="GIFS — Onovich" activePage="/gif" pageClass="page-gif page-gallery-tight">
  <div class="gif-hero">
    <img
      src="/images/gifs/hero.gif"
      alt=""
      width="750"
      height="553"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>
  {items.length > 0
    ? <Gallery items={items} dense={true} natural={true} eagerThumbs={true} showCaptions={false} />
    : <p style="color: rgba(0,0,0,0.4); font-size: 1.1rem;">暂无内容</p>}
</BaseLayout>
