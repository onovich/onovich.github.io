---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import items from '../content/photos.json';
---
<BaseLayout title="PHOTOS — Onovich" activePage="/photo">
  {items.length > 0
    ? <Gallery items={items} />
    : <p style="color: rgba(0,0,0,0.4); font-size: 1.1rem;">暂无内容</p>}
</BaseLayout>
