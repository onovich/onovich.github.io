---
import '@fontsource/nunito/300.css';
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/600.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
  backHref?: string;
  backLabel?: string;
  pageClass?: string;
}
const {
  title = 'Onovich',
  description = 'Onovich — creates games on a sofa.',
  activePage = '',
  backHref = '/',
  backLabel = 'HOME',
  pageClass = '',
} = Astro.props;

const navLinks = [
  { href: '/codes',       label: 'CODES' },
  { href: '/game',        label: 'GAMES' },
  { href: '/pixel',       label: 'PIXEL ARTS' },
  { href: '/illustrator', label: 'ILLUSTRATIONS' },
  { href: '/gif',         label: 'GIFS' },
  { href: '/graphic',     label: 'GRAPHIC DESIGNS' },
  { href: '/photo',       label: 'PHOTOS' },
  { href: '/poem',        label: 'POEMS' },
  { href: '/sns',         label: 'SNS' },
  { href: '/links',       label: 'LINKS' },
  { href: '/contact',     label: 'MESSAGE' },
];

// Original site splits the home navigation into two H2 blocks separated by a
// blank line: content categories (CODES…POEMS) and outbound links (SNS…MESSAGE).
const navMain   = navLinks.slice(0, 8);
const navSocial = navLinks.slice(8);
const isHome    = activePage === '/';
const isContact = activePage === '/contact';
const bodyClass = [
  isHome ? 'page-home' : isContact ? 'page-contact' : 'page-inner',
  pageClass,
].filter(Boolean).join(' ');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body class={bodyClass}>
    <!-- Floating hamburger button (top-right) -->
    <button class="site-menu-button" id="siteMenuBtn" aria-label="Open menu">≡</button>

    <!-- Slide-in dark menu panel -->
    <aside class="site-menu" id="siteMenu" aria-hidden="true">
      <div class="site-menu__close" id="siteMenuClose">×</div>
      <nav>
        <a href="/" class={`page-link ${activePage === '/' ? 'active' : ''}`}>Homepage</a>
        <div class="break"></div>
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`page-link ${activePage === link.href ? 'active' : ''}`}
          >{link.label}</a>
        ))}
      </nav>
    </aside>
    <div class="site-menu__backdrop" id="siteMenuBackdrop"></div>

    <main class="container">
      <div class="container_width">
        <bodycopy class="bodycopy content content_padding">
          <div class="page_content home-grid">
            <!-- LEFT COL — site nav (rendered on every page, mirrors original Cargo pinned overlay) -->
            <div class="home-grid__col home-grid__col--nav">
              <h1><a href="/">Onovich</a></h1>
              <h2 class="home-nav">
                {navMain.map((link, i) => (
                  <>
                    <a
                      href={link.href}
                      class={activePage === link.href ? 'active' : ''}
                    >{link.label}</a>
                    {i < navMain.length - 1 && <br />}
                  </>
                ))}
              </h2>
              <h2 class="home-nav home-nav--social">
                {navSocial.map((link, i) => (
                  <>
                    <a
                      href={link.href}
                      class={activePage === link.href ? 'active' : ''}
                    >{link.label}</a>
                    {i < navSocial.length - 1 && <br />}
                  </>
                ))}
              </h2>
            </div>

            <!-- RIGHT COL — page-specific content -->
            <div class="home-grid__col home-grid__col--main">
              {!isHome && !isContact && (
                <div class="page-back">
                  <a href={backHref}>&lt; {backLabel}</a>
                </div>
              )}
              <slot />
            </div>
          </div>
        </bodycopy>
      </div>
    </main>

    <footer class="site-footer">
      <span class="build-version">v2.3.0-astro · 2026-04-29</span>
    </footer>

    <script>
      const btn = document.getElementById('siteMenuBtn');
      const menu = document.getElementById('siteMenu');
      const close = document.getElementById('siteMenuClose');
      const backdrop = document.getElementById('siteMenuBackdrop');

      const open = () => {
        document.body.classList.add('menu-open');
        menu?.setAttribute('aria-hidden', 'false');
      };
      const shut = () => {
        document.body.classList.remove('menu-open');
        menu?.setAttribute('aria-hidden', 'true');
      };
      btn?.addEventListener('click', open);
      close?.addEventListener('click', shut);
      backdrop?.addEventListener('click', shut);
      menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', shut));

      // Cargo-style mobile body class: viewport <= 768
      const setMobileClass = () => {
        if (window.innerWidth <= 768) document.body.classList.add('mobile');
        else document.body.classList.remove('mobile');
      };
      setMobileClass();
      window.addEventListener('resize', setMobileClass);
    </script>
  </body>
</html>
