---
import '../styles/global.css';
import {
  copy,
  pagePath,
  siteUrl,
  type Language,
  type PageKey,
} from '../content/portfolio';

interface Props {
  lang: Language;
  activePage: PageKey | null;
  title: string;
  description: string;
  canonicalPath: string;
  alternatePath: string;
  socialImage?: string;
  pageClass?: string;
  noindex?: boolean;
}

const {
  lang,
  activePage,
  title,
  description,
  canonicalPath,
  alternatePath,
  socialImage,
  pageClass = '',
  noindex = false,
} = Astro.props;

const text = copy[lang];
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const alternateUrl = new URL(alternatePath, siteUrl).toString();
const englishPath = lang === 'en' ? canonicalPath : alternatePath;
const chinesePath = lang === 'zh-CN' ? canonicalPath : alternatePath;
const englishUrl = new URL(englishPath, siteUrl).toString();
const chineseUrl = new URL(chinesePath, siteUrl).toString();
const socialImagePath = socialImage ?? (lang === 'zh-CN'
  ? '/images/social/onovich-zh.png'
  : '/images/social/onovich-en.png');
const socialImageUrl = new URL(socialImagePath, siteUrl).toString();

const navItems: Array<{ key: PageKey; href: string; label: string }> = [
  { key: 'home', href: pagePath('home', lang), label: text.nav.home },
  { key: 'work', href: pagePath('work', lang), label: text.nav.work },
  { key: 'art', href: pagePath('art', lang), label: text.nav.art },
  { key: 'writing', href: pagePath('writing', lang), label: text.nav.writing },
  { key: 'profile', href: pagePath('profile', lang), label: text.nav.profile },
  { key: 'contact', href: pagePath('contact', lang), label: text.nav.contact },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Onovich',
  url: siteUrl,
  image: new URL('/images/profile/avatar.jpg', siteUrl).toString(),
  jobTitle: lang === 'zh-CN' ? '游戏系统工程师' : 'Game systems engineer',
  sameAs: [
    'https://github.com/onovich',
    'https://twitter.com/Umbra_Onovich',
    'https://steamcommunity.com/id/onovich',
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <meta name="color-scheme" content="light" />

    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Onovich" />
    <meta property="og:locale" content={lang === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class:list={[`page-${activePage ?? 'not-found'}`, pageClass]}>
    <a class="skip-link" href="#main">{text.skip}</a>

    <header class="mobile-header">
      <a class="mobile-wordmark" href={pagePath('home', lang)}>Onovich</a>
      <div class="mobile-header__actions">
        <div class="language-switch language-switch--mobile" aria-label="Language">
          <a href={englishPath} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
          <span aria-hidden="true">/</span>
          <a href={chinesePath} hreflang="zh-CN" lang="zh-CN" aria-current={lang === 'zh-CN' ? 'true' : undefined}>中文</a>
        </div>
        <button class="menu-button" type="button" data-menu-open aria-expanded="false" aria-controls="mobile-index">{text.index}</button>
      </div>
    </header>

    <aside class="mobile-index" id="mobile-index" data-mobile-index aria-hidden="true">
      <button class="mobile-index__close" type="button" data-menu-close aria-label={text.close}>×</button>
      <div class="mobile-index__inner">
        <nav class="route-nav route-nav--mobile" aria-label="Mobile primary navigation">
          {navItems.map(item => (
            <a href={item.href} aria-current={activePage === item.key ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <a class="external-link external-link--mobile" href="https://github.com/onovich" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </aside>
    <button class="mobile-index__backdrop" type="button" data-menu-close aria-label={text.close} tabindex="-1"></button>

    <div class="site-frame">
      <aside class="site-index" aria-label="Site index">
        <a class="wordmark" href={pagePath('home', lang)}>Onovich</a>

        <nav class="route-nav" aria-label="Primary navigation">
          {navItems.map(item => (
            <a href={item.href} aria-current={activePage === item.key ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>

        <div class="index-utility">
          <div class="language-switch" aria-label="Language">
            <a href={englishPath} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
            <span aria-hidden="true">/</span>
            <a href={chinesePath} hreflang="zh-CN" lang="zh-CN" aria-current={lang === 'zh-CN' ? 'true' : undefined}>中文</a>
          </div>
          <a class="external-link" href="https://github.com/onovich" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </aside>

      <main class="site-content" id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <span>Onovich · <span data-year>{new Date().getFullYear()}</span></span>
      </footer>
    </div>

    <script>
      const body = document.body;
      const menu = document.querySelector('[data-mobile-index]');
      const openButton = document.querySelector('[data-menu-open]');
      const closeButtons = document.querySelectorAll('[data-menu-close]');

      const openMenu = () => {
        body.classList.add('menu-open');
        menu?.setAttribute('aria-hidden', 'false');
        openButton?.setAttribute('aria-expanded', 'true');
      };

      const closeMenu = () => {
        body.classList.remove('menu-open');
        menu?.setAttribute('aria-hidden', 'true');
        openButton?.setAttribute('aria-expanded', 'false');
      };

      openButton?.addEventListener('click', openMenu);
      closeButtons.forEach(button => button.addEventListener('click', closeMenu));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') closeMenu();
      });

    </script>
  </body>
</html>
